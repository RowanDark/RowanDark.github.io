---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemap.org/schemas/sitemap/0.9">
{% assign pages = site.html_pages | where_exp: "p", "p.sitemap != false" %}
{% for p in pages %}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
{% if p.last_modified_at %}    <lastmod>{{ p.last_modified_at | date_to_xmlschema }}</lastmod>
{% endif %}  </url>
{% endfor %}
</urlset>
